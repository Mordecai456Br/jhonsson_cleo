{
  "expo": {
    "name": "Kitty Shop",
    "slug": "kitty-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kittyshop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.kittyshop"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/static/Inter_18pt-Black.ttf",
            "./assets/fonts/static/Inter_18pt-Black.ttf",
            "./assets/fonts/static/Inter_18pt-Black.ttf",
            "./assets/fonts/static/Inter_18pt-Black.ttf",
            "./assets/fonts/static/Inter_18pt-Black.ttf",
            "./assets/fonts/static/Inter_18pt-BlackItalic.ttf",
            "./assets/fonts/static/Inter_18pt-Bold.ttf",
            "./assets/fonts/static/Inter_18pt-BoldItalic.ttf",
            "./assets/fonts/static/Inter_18pt-ExtraBold.ttf",
            "./assets/fonts/static/Inter_18pt-ExtraBoldItalic.ttf",
            "./assets/fonts/static/Inter_18pt-ExtraLight.ttf",
            "./assets/fonts/static/Inter_18pt-ExtraLightItalic.ttf",
            "./assets/fonts/static/Inter_18pt-Italic.ttf",
            "./assets/fonts/static/Inter_18pt-Light.ttf",
            "./assets/fonts/static/Inter_18pt-LightItalic.ttf",
            "./assets/fonts/static/Inter_18pt-Medium.ttf",
            "./assets/fonts/static/Inter_18pt-MediumItalic.ttf",
            "./assets/fonts/static/Inter_18pt-Regular.ttf",
            "./assets/fonts/static/Inter_18pt-SemiBold.ttf",
            "./assets/fonts/static/Inter_18pt-SemiBoldItalic.ttf",
            "./assets/fonts/static/Inter_18pt-Thin.ttf",
            "./assets/fonts/static/Inter_18pt-ThinItalic.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
